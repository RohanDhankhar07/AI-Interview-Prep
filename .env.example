# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for development. Every value below is available free.
# ─────────────────────────────────────────────────────────────────────────────

# Session signing key. Any random string of 32+ characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-me-with-32-plus-random-characters

# MongoDB connection string (MongoDB Atlas has a free M0 tier).
# Verify it with `npm run db:check`, which reports which stage fails and how to fix it.
# Atlas also needs your IP on its access list (Network Access › Add IP Address), plus
# 0.0.0.0/0 for Vercel, whose egress IPs are not fixed on the free tier.
# Percent-encode the password if it contains @ : / ? # [ ] or %.
# Optional in development: with no URI the app uses an in-memory store that is
# wiped on restart. Required in production — the app refuses to start without it.
MONGODB_URI=
MONGODB_DB=interview_prep_kit

# ── Model ────────────────────────────────────────────────────────────────────
# groq (default) | gemini | openrouter | cerebras | mock
# "mock" is a deterministic offline model: no key, no network, structurally real
# kits with derived content. Useful for a smoke test; not for real preparation.
LLM_PROVIDER=groq
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=

# Override the model, or point at any OpenAI-compatible endpoint.
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=
# LLM_API_KEY=

# Free tiers cap tokens per minute as well as requests; these keep us under them.
LLM_CONCURRENCY=2
LLM_MIN_INTERVAL_MS=350
LLM_RETRY_ATTEMPTS=4
LLM_TIMEOUT_MS=90000

# ── Web search (for public discussion of a company's interview process) ───────
# Optional. With no key we fall back to DuckDuckGo, which needs no credentials
# but is best-effort. Set SEARCH_DISABLED=true to skip the step entirely.
# SERPER_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SEARCH_DISABLED=false

# ── Crawler ──────────────────────────────────────────────────────────────────
CRAWLER_USER_AGENT=InterviewPrepKitBot/1.0 (+https://your-deployment.example)
CRAWL_MAX_PAGES=7
FETCH_TIMEOUT_MS=12000
FETCH_MAX_BYTES=2000000
FETCH_MIN_INTERVAL_MS=350
# Set to false to ignore robots.txt. Left alone, robots is respected.
# RESPECT_ROBOTS=true

# Allow fetching private/loopback addresses. Defaults to true outside production
# and false in production. The batch runner sets it for local company fixtures.
# ALLOW_PRIVATE_NETWORK=false

# How long one /advance slice may run. Keep below your platform's function limit.
ADVANCE_BUDGET_MS=25000
